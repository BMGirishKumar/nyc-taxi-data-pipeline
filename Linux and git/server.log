#cron jobs:
These jobs run automatically so that we dont have to do it manually 

eg:
#!/bin/bash

# Define variables
SOURCE_DIR="/var/www/html"
BACKUP_DIR="/backup"

# Conditional Check (If directory exists)
if [ -d "$SOURCE_DIR" ]; then
    echo "Starting backup of $SOURCE_DIR..."
    tar -czf "$BACKUP_DIR/backup_$(date +%F).tar.gz" "$SOURCE_DIR"
    echo "Backup complete!"
else
    echo "Error: Source directory does not exist."
    exit 1
fi


# Open cron editor using: crontab -e
0 0 * * * /bin/bash /scripts/backup.sh


# Set a temporary environment variable
export DB_PASSWORD="SuperSecretPassword123"

# Access it in terminal or code
echo $DB_PASSWORD

# Make it permanent by adding it to your user profile
echo 'export DB_PASSWORD="SuperSecretPassword123"' >> ~/.bashrc
source ~/.bashrc
